{
  "id": "tool.postprocess_compare.gaussian_rendering",
  "name": "进行高斯渲染操作",
  "version": "1.0.0",
  "description": "来自现有 Airtest 用例：进行高斯渲染操作，等待进度条完成并记录截图和耗时。",
  "params_schema": {
    "timeout_sec": {
      "type": "number",
      "default": 900,
      "description": "等待高斯渲染进度条出现和消失的总超时（秒），默认 15 分钟。"
    },
    "gaussian_quality": {
      "type": "string",
      "default": "高质量",
      "enum": ["快速", "标准", "高质量"],
      "description": "高斯渲染质量等级：快速(70,220)、标准(180,220)、高质量(290,220)，默认高质量。"
    }
  }
}
